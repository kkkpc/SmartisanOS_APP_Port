# 反编译产物（体积大，可重建，不提交）
/apktool/
/decompiled/
/.apktool-framework/
/dist/
/build/

# 系统/编辑器
.DS_Store
*.swp
.idea/
.vscode/

# 签名密钥绝不入库
*.jks
*.keystore
*.p12
signing.properties

# 测试构建产物（源码 test/ 提交）
/test/lib-classes/
/test/build/

# 交付物：APK 与解包审计产物不入库（构建可复现，SHA256 在 audit/*.txt）
deliverables/*.apk
deliverables/audit/apk-inspect/
deliverables/audit/baksmali-check/
deliverables/audit/aapt2bin/
deliverables/audit/jar-analysis/
# 本机 rename 迁移审计（每次 decode 不同）
audit/
