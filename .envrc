# Smartisan Calendar 二次开发环境配置
#
# 用法（无需 direnv 也可手动 source）：
#   source .envrc          # 临时把本项目工具加入 PATH
#   或安装 direnv 后进入目录自动生效
#
# 设计目标：项目级隔离，不修改全局工具版本。
# 反编译工具链固定在本仓库 Tool/ 与 .apktool-framework/ 中。

# ---- Java ----
# 全局 java 是 Apple 占位符（/usr/bin/java，会报 "Unable to locate a Java Runtime"）。
# Homebrew 的 OpenJDK 才是可用的；这里把它放到 PATH 最前面。
if [ -x "/opt/homebrew/opt/openjdk/bin/java" ]; then
  export JAVA_HOME="/opt/homebrew/opt/openjdk"
  export PATH="$JAVA_HOME/bin:$PATH"
elif [ -x "/usr/libexec/java_home" ] && [ -n "$(/usr/libexec/java_home 2>/dev/null)" ]; then
  export JAVA_HOME="$(/usr/libexec/java_home)"
  export PATH="$JAVA_HOME/bin:$PATH"
fi

# ---- Apktool ----
# 优先用仓库自带的 jar（版本与本项目锁定），其次用 brew 全局 apktool。
# REPO_ROOT 为本文件所在目录。
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export APKTOOL_HOME="$REPO_ROOT/.apktool-framework"
if [ -f "$REPO_ROOT/Tool/apktool.jar" ]; then
  apktool() { "$JAVA_HOME/bin/java" -jar "$REPO_ROOT/Tool/apktool.jar" "$@"; }
  export -f apktool 2>/dev/null || true
elif command -v apktool >/dev/null 2>&1; then
  : # 用全局 apktool（需自行保证版本一致）
fi

echo "[envrc] JAVA_HOME=$JAVA_HOME"
java -version 2>&1 | head -1
